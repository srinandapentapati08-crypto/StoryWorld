rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Any logged-in user can read
      allow read: if request.auth != null;
      // Only admin can write/delete
      allow write: if request.auth != null && request.auth.uid == "REPLACE_WITH_ADMIN_UID";
    }
  }
}
